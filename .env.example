# Postgres connection string. Locally: run a Postgres server and point here.
# On Vercel: add the "Postgres" storage integration (Neon-backed) and it will
# inject this automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/nails_website"

AUTH_SECRET="dev-secret-change-me-in-production-please-please"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (test mode) - get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal (sandbox) - get client id from https://developer.paypal.com/dashboard/applications
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"
